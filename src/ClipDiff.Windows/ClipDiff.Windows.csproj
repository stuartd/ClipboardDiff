<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>ClipDiff.Windows</RootNamespace>
    <AssemblyName>ClipDiff</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/ClipDiff.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ClipDiff.Core/ClipDiff.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/ClipDiff.ico" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../../artifacts/native/$(Configuration)/ClipDiff.ShellExtension.dll')">
    <Content Include="../../artifacts/native/$(Configuration)/ClipDiff.ShellExtension.dll"
             Link="ClipDiff.ShellExtension.dll" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
