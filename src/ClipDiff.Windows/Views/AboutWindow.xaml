<Window x:Class="ClipDiff.Windows.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="About ClipDiff"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/ClipDiff.ico"
        Background="#202020"
        Foreground="#F5F5F5"
        SourceInitialized="OnSourceInitialized"
        Closing="OnClosing">
    <Window.Resources>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#66B6FF" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#323232" />
            <Setter Property="Foreground" Value="#F5F5F5" />
            <Setter Property="BorderBrush" Value="#606060" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D3D3D" />
                    <Setter Property="BorderBrush" Value="#7A7A7A" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#484848" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Image Grid.Row="0"
               Grid.Column="0"
               Width="76"
               Height="76"
               Margin="0,2,20,0"
               VerticalAlignment="Top"
               Source="/Assets/ClipDiff.ico"
               Stretch="Uniform"
               automation:AutomationProperties.Name="ClipDiff application icon" />

        <StackPanel Grid.Row="0" Grid.Column="1">
            <TextBlock Text="ClipDiff" FontSize="26" FontWeight="SemiBold" />
            <TextBlock x:Name="VersionText"
                       Margin="0,2,0,16"
                       Opacity="0.72" />
            <TextBlock Text="A minimal clipboard comparison tool."
                       Margin="0,0,0,16"
                       TextWrapping="Wrap" />
            <TextBlock>
                <Hyperlink NavigateUri="https://github.com/stuartd/ClipboardDiff"
                           RequestNavigate="OnLinkRequestNavigate">github.com/stuartd/ClipboardDiff</Hyperlink>
            </TextBlock>
        </StackPanel>

        <Button Grid.Row="1"
                Grid.Column="1"
                Content="Close"
                Width="82"
                Margin="0,24,0,0"
                Padding="12,5"
                HorizontalAlignment="Right"
                Click="OnCloseClick" />
    </Grid>
</Window>
