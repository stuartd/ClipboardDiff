<Window x:Class="ClipDiff.Windows.Views.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:ClipDiff;assembly=ClipDiff.Core"
        xmlns:viewModels="clr-namespace:ClipDiff.Windows.ViewModels"
        Title="ClipDiff"
        Width="1120"
        Height="720"
        MinWidth="760"
        MinHeight="480"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="ReadOnlyDiffText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            <Setter Property="FontFamily" Value="Consolas, Courier New" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style x:Key="OldCell" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DiffKind.Removed}">
                    <Setter Property="Background" Value="#35FF5A5A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DiffKind.Changed}">
                    <Setter Property="Background" Value="#35FF5A5A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NewCell" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DiffKind.Inserted}">
                    <Setter Property="Background" Value="#3548D66D" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DiffKind.Changed}">
                    <Setter Property="Background" Value="#3548D66D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UnifiedLine" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static viewModels:UnifiedLineKind.Header}">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static viewModels:UnifiedLineKind.Removed}">
                    <Setter Property="Background" Value="#35FF5A5A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static viewModels:UnifiedLineKind.Inserted}">
                    <Setter Property="Background" Value="#3548D66D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Text="Clipboard Diff" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}" Margin="0,3,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="2"
                          Width="128"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          SelectedIndex="{Binding SelectedViewIndex}">
                    <ComboBoxItem Content="Side by Side" />
                    <ComboBoxItem Content="Unified" />
                </ComboBox>
                <Button Grid.Column="3"
                        Content="Copy diff"
                        Command="{Binding CopyCommand}"
                        Padding="14,6"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center" />
                <Button Grid.Column="4"
                        Content="Clear captured text"
                        Command="{Binding ClearCommand}"
                        Padding="14,6"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <StackPanel Visibility="{Binding EmptyVisibility}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextBlock.TextAlignment="Center">
                <TextBlock Text="No Diff" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Copy two text values, then use Show Diff."
                           Margin="0,8,0,0"
                           FontSize="14" />
            </StackPanel>

            <Grid Visibility="{Binding SideBySideVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0"
                      Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="#" Padding="8,7" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding PreviousLabel}"
                               Padding="6,7"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               ToolTip="{Binding PreviousLabel}" />
                    <TextBlock Grid.Column="2" Text="#" Padding="8,7" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding CurrentLabel}"
                               Padding="6,7"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               ToolTip="{Binding CurrentLabel}" />
                </Grid>
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Rows}"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource OldCell}">
                                        <TextBlock Text="{Binding OldLineNumber}" Padding="8,6" Opacity="0.7" />
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource OldCell}">
                                        <TextBox Text="{Binding OldText, Mode=OneWay}" Style="{StaticResource ReadOnlyDiffText}" />
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource NewCell}">
                                        <TextBlock Text="{Binding NewLineNumber}" Padding="8,6" Opacity="0.7" />
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource NewCell}">
                                        <TextBox Text="{Binding NewText, Mode=OneWay}" Style="{StaticResource ReadOnlyDiffText}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <ListBox Visibility="{Binding UnifiedVisibility}"
                     ItemsSource="{Binding UnifiedLines}"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource UnifiedLine}"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                BorderThickness="0,0,0,1">
                            <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource ReadOnlyDiffText}" />
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
