<Window x:Class="ClipDiff.Windows.Views.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:ClipDiff;assembly=ClipDiff.Core"
        xmlns:views="clr-namespace:ClipDiff.Windows.Views"
        xmlns:viewModels="clr-namespace:ClipDiff.Windows.ViewModels"
        Title="ClipDiff"
        Width="1120"
        Height="720"
        MinWidth="760"
        MinHeight="480"
        Background="#202020"
        Foreground="#F5F5F5"
        SourceInitialized="OnSourceInitialized"
        Closing="OnClosing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#323232" />
            <Setter Property="Foreground" Value="#F5F5F5" />
            <Setter Property="BorderBrush" Value="#606060" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D3D3D" />
                    <Setter Property="BorderBrush" Value="#7A7A7A" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#484848" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#323232" />
            <Setter Property="Foreground" Value="#F5F5F5" />
            <Setter Property="BorderBrush" Value="#606060" />
			<!-- Own the template so Windows theme brushes cannot replace the dark colours. -->
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ComboBox">
						<Grid>
							<ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
							              Background="{TemplateBinding Background}"
							              BorderBrush="{TemplateBinding BorderBrush}"
							              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
								<ToggleButton.Template>
									<ControlTemplate TargetType="ToggleButton">
										<Border Background="{TemplateBinding Background}" BorderThickness="1"
										        BorderBrush="{TemplateBinding BorderBrush}">
											<Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#F5F5F5"
											      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
										</Border>
									</ControlTemplate>
								</ToggleButton.Template>
							</ToggleButton>
							<ContentPresenter IsHitTestVisible="False" Margin="10,6,28,6" VerticalAlignment="Center"
							                  TextElement.Foreground="{TemplateBinding Foreground}"
							                  Content="{TemplateBinding SelectionBoxItem}"
							                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
							                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
							<Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
							       IsOpen="{TemplateBinding IsDropDownOpen}">
								<Border Background="#323232" BorderBrush="#606060" BorderThickness="1"
								        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
								        MaxHeight="{TemplateBinding MaxDropDownHeight}">
									<ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
										<ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
									</ScrollViewer>
								</Border>
							</Popup>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="DropDownToggle" Property="Background" Value="#424242" />
							</Trigger>
							<Trigger Property="IsKeyboardFocusWithin" Value="True">
								<Setter TargetName="DropDownToggle" Property="BorderBrush" Value="#93BFFF" />
							</Trigger>
							<Trigger Property="IsDropDownOpen" Value="True">
								<Setter TargetName="DropDownToggle" Property="Background" Value="#424242" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.6" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#323232" />
            <Setter Property="Foreground" Value="#F5F5F5" />
			<Setter Property="Padding" Value="10,6" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ComboBoxItem">
						<Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
							<ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#3D3D3D" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#365F91" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#202020" />
            <Setter Property="Foreground" Value="#F5F5F5" />
        </Style>
        <Style x:Key="ReadOnlyDiffText" TargetType="views:DiffTextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F5F5F5" />
            <Setter Property="SelectionBrush" Value="#365F91" />
            <Setter Property="FontFamily" Value="Consolas, Courier New" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style x:Key="OldCell" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DiffKind.Removed}">
                    <Setter Property="Background" Value="#1FFF5A5A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DiffKind.Changed}">
                    <Setter Property="Background" Value="#1FFF5A5A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NewCell" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DiffKind.Inserted}">
                    <Setter Property="Background" Value="#1F48D66D" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DiffKind.Changed}">
                    <Setter Property="Background" Value="#1F48D66D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UnifiedLine" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static viewModels:UnifiedLineKind.Header}">
                    <Setter Property="Background" Value="#2A2A2A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static viewModels:UnifiedLineKind.Removed}">
                    <Setter Property="Background" Value="#1FFF5A5A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static viewModels:UnifiedLineKind.Inserted}">
                    <Setter Property="Background" Value="#1F48D66D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F5F5F5" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#464646"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Text="Clipboard Diff" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}" Margin="0,3,0,0" />
                </StackPanel>
                <CheckBox Grid.Row="1" Grid.ColumnSpan="4" Content="Ignore spacing"
                          Foreground="#F5F5F5" Margin="0,10,0,0"
                          IsChecked="{Binding IgnoreSpacing}" />
                <ComboBox Grid.Column="2"
				          AutomationProperties.Name="Diff view"
                          Width="128"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          SelectedIndex="{Binding SelectedViewIndex}">
                    <ComboBoxItem Content="Side by Side" />
                    <ComboBoxItem Content="Unified" />
                </ComboBox>
                <Button Grid.Column="3"
                        Content="Copy unified diff"
                        Command="{Binding CopyCommand}"
                        Padding="14,6"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <StackPanel Visibility="{Binding EmptyVisibility}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextBlock.TextAlignment="Center">
                <TextBlock Text="No Diff" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Copy two text values, then use Show Diff."
                           Margin="0,8,0,0"
                           FontSize="14" />
            </StackPanel>

            <Grid Visibility="{Binding SideBySideVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0"
                      Background="#2A2A2A">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="#" Padding="8,7" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding PreviousLabel}"
                               Padding="6,7"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               ToolTip="{Binding PreviousLabel}" />
                    <TextBlock Grid.Column="2" Text="#" Padding="8,7" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding CurrentLabel}"
                               Padding="6,7"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               ToolTip="{Binding CurrentLabel}" />
                </Grid>
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Rows}"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#464646"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource OldCell}">
                                        <TextBlock Text="{Binding OldLineNumber}" Padding="8,6" Opacity="0.7" />
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource OldCell}">
                                        <views:DiffTextBox SourceText="{Binding OldText}" Highlights="{Binding OldHighlights}" HighlightBrush="#47FF5A5A" Style="{StaticResource ReadOnlyDiffText}" />
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource NewCell}">
                                        <TextBlock Text="{Binding NewLineNumber}" Padding="8,6" Opacity="0.7" />
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource NewCell}">
                                        <views:DiffTextBox SourceText="{Binding NewText}" Highlights="{Binding NewHighlights}" HighlightBrush="#4748D66D" Style="{StaticResource ReadOnlyDiffText}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <ListBox Visibility="{Binding UnifiedVisibility}"
                     ItemsSource="{Binding UnifiedLines}"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource UnifiedLine}"
                                BorderBrush="#464646"
                                BorderThickness="0,0,0,1">
                            <views:DiffTextBox SourceText="{Binding Text}" Prefix="{Binding Prefix}" Highlights="{Binding Highlights}">
                                <views:DiffTextBox.Style>
                                    <Style TargetType="views:DiffTextBox" BasedOn="{StaticResource ReadOnlyDiffText}">
                                        <Setter Property="HighlightBrush" Value="#47FF5A5A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static viewModels:UnifiedLineKind.Inserted}">
                                                <Setter Property="HighlightBrush" Value="#4748D66D" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </views:DiffTextBox.Style>
                            </views:DiffTextBox>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
