<Window x:Class="ClipDiff.Windows.Views.ShortcutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Keyboard shortcut"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/ClipDiff.ico"
        Background="#202020"
        Foreground="#F5F5F5"
        SourceInitialized="OnSourceInitialized"
        Loaded="OnLoaded">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#323232" />
            <Setter Property="Foreground" Value="#F5F5F5" />
            <Setter Property="BorderBrush" Value="#606060" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D3D3D" />
                    <Setter Property="BorderBrush" Value="#7A7A7A" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#484848" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Keyboard shortcut"
                   FontSize="22"
                   FontWeight="SemiBold" />

        <TextBlock Grid.Row="1"
                   Margin="0,8,0,16"
                   Text="Click the box, press a shortcut containing Ctrl or Alt, then choose Save."
                   TextWrapping="Wrap"
                   Opacity="0.78" />

        <TextBox x:Name="ShortcutBox"
                 Grid.Row="2"
                 Height="48"
                 Padding="12,8"
                 HorizontalContentAlignment="Center"
                 VerticalContentAlignment="Center"
                 IsReadOnly="True"
                 Cursor="Arrow"
                 FontFamily="Consolas"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Background="#2A2A2A"
                 Foreground="#F5F5F5"
                 BorderBrush="#727272"
                 SelectionBrush="#365F91"
                 PreviewKeyDown="OnShortcutPreviewKeyDown"
                 automation:AutomationProperties.Name="Shortcut capture box" />

        <TextBlock x:Name="ValidationText"
                   Grid.Row="3"
                   MinHeight="38"
                   Margin="0,8,0,6"
                   Foreground="#FF9B9B"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Reset to Ctrl+Alt+D"
                    Padding="12,5"
                    Click="OnResetClick" />
            <Button Grid.Column="2"
                    Content="Cancel"
                    Width="82"
                    Margin="8,0,0,0"
                    Padding="12,5"
                    IsCancel="True"
                    Click="OnCancelClick" />
            <Button x:Name="SaveButton"
                    Grid.Column="3"
                    Content="Save"
                    Width="82"
                    Margin="8,0,0,0"
                    Padding="12,5"
                    IsDefault="True"
                    Click="OnSaveClick" />
        </Grid>
    </Grid>
</Window>
